@model ChemicalSDS.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="icon" type="image/png" href="~/images/logo-ciwe.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/images/logo-ciwe.png" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <aside class="login-brand" aria-hidden="true">
            <div class="login-brand-inner">
                <div class="login-brand-head">
                    <div class="login-brand-icon">
                        <img src="~/images/logo-ciwe.png" alt="C.I.W.C&amp;E — Govt of Punjab" class="login-brand-logo" />
                    </div>
                    <div class="login-brand-text">
                        <h1>C.I.W.C&amp;E</h1>
                        <p class="govt-line">DGLW — Govt of Punjab</p>
                    </div>
                </div>
                <ul class="login-brand-features">
                    <li><i class="fas fa-file-alt"></i> 16-section SDS management</li>
                    <li><i class="fas fa-shield-alt"></i> Chemical safety compliance</li>
                    <li><i class="fas fa-search"></i> Search &amp; track all chemicals</li>
                </ul>
            </div>
        </aside>

        <main class="login-form-panel">
            <div class="login-card">
                <div class="login-mobile-brand">
                    <img src="~/images/logo-ciwe.png" alt="" class="login-brand-logo-sm" />
                    <div class="login-mobile-brand-text">
                        <h3>C.I.W.C&amp;E</h3>
                        <p>DGJW — Govt of Punjab</p>
                    </div>
                </div>

                <header class="login-card-header">
                    <h2>Sign in</h2>
                    <p>Chemical Safety Data Sheet System</p>
                </header>

                @if (ViewBag.Error != null)
                {
                    <div class="login-alert" role="alert">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" asp-action="Login" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="login-field">
                        <label asp-for="Username">Username</label>
                        <div class="login-input-wrap">
                            <i class="fas fa-user field-icon"></i>
                            <input asp-for="Username" placeholder="Enter your username" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="login-field">
                        <label asp-for="Password">Password</label>
                        <div class="login-input-wrap">
                            <i class="fas fa-lock field-icon"></i>
                            <input asp-for="Password" id="passwordInput" placeholder="Enter your password" autocomplete="current-password" />
                            <button type="button" class="toggle-pwd" id="togglePwd" aria-label="Show password">
                                <i class="fas fa-eye" id="togglePwdIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="login-captcha">
                        <div class="login-captcha-label">
                            <i class="fas fa-calculator"></i>
                            Security check
                        </div>
                        <div class="captcha-equation" aria-label="Add @Model.CaptchaNum1 and @Model.CaptchaNum2">
                            <span class="captcha-num">@Model.CaptchaNum1</span>
                            <span class="captcha-op">+</span>
                            <span class="captcha-num">@Model.CaptchaNum2</span>
                            <span class="captcha-equals">=</span>
                            <span class="captcha-op">?</span>
                        </div>
                        <div class="captcha-answer-wrap">
                            <input asp-for="CaptchaAnswer" type="number" inputmode="numeric" min="0" max="99"
                                   placeholder="Your answer" autocomplete="off" />
                        </div>
                        <p class="captcha-hint"></p>
                        <span asp-validation-for="CaptchaAnswer" class="text-danger small d-block text-center mt-1"></span>
                    </div>

                    <button type="submit" class="btn-login-submit">
                        <i class="fas fa-sign-in-alt"></i>
                        Sign in
                    </button>
                </form>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var pwd = document.getElementById('passwordInput');
            var btn = document.getElementById('togglePwd');
            var icon = document.getElementById('togglePwdIcon');
            if (!pwd || !btn) return;
            btn.addEventListener('click', function () {
                var show = pwd.type === 'password';
                pwd.type = show ? 'text' : 'password';
                icon.classList.toggle('fa-eye', !show);
                icon.classList.toggle('fa-eye-slash', show);
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        })();
    </script>
</body>
</html>
