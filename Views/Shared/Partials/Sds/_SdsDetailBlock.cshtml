@model ChemicalSDS.Models.SdsDetailRow
@using ChemicalSDS.Models
@if (!string.IsNullOrWhiteSpace(Model.Value))
{
    var rich = Sec01SubsectionCodec.LooksLikeRichText(Model.Value);
    <div class="sds-detail-row@(string.IsNullOrWhiteSpace(Model.Label) ? " sds-detail-row-block" : "")">
        @if (!string.IsNullOrWhiteSpace(Model.Label))
        {
            <span class="sds-detail-label">@Model.Label</span>
        }
        @if (rich)
        {
            <div class="sds-detail-value sds-rich-text">@Html.Raw(Sec01SubsectionCodec.SanitizeRichText(Model.Value))</div>
        }
        else
        {
            <span class="sds-detail-value">@Html.Raw(Model.Value.Replace("\n", "<br/>"))</span>
        }
    </div>
}
