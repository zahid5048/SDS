@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var sessionRole = Context.Session.GetString("Role") ?? "";
    var isAdmin = string.Equals(sessionRole, "Admin", StringComparison.OrdinalIgnoreCase);

    bool IsActive(string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

    string ItemClass(string controller, string action) =>
        IsActive(controller, action) ? "nav-item active" : "nav-item";

    string ControllerItemClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "nav-item active" : "nav-item";
}

<aside class="app-sidebar" id="appSidebar">
    <div class="sidebar-header">
        <div class="sidebar-brand-row">
            <img src="~/images/logo-ciwe.png" alt="C.I.W.C&amp;E" class="sidebar-logo" asp-append-version="true" />
            <div class="sidebar-brand-text">
                <h3>C.I.W.C&amp;E</h3>
                <p>DGJW Govt of Punjab</p>
            </div>
        </div>
    </div>

    <nav class="sidebar-nav" aria-label="Main navigation">
        <p class="nav-section-title">Main</p>
        <ul class="sidebar-nav-list">
            <li class="@ItemClass("Home", "Dashboard")">
                <a asp-controller="Home" asp-action="Dashboard">
                    <span class="nav-icon-wrap" aria-hidden="true"><i class="fas fa-tachometer-alt"></i></span>
                    <span class="nav-label">Dashboard</span>
                </a>
            </li>
            <li class="@ItemClass("SdsWizard", "Step")">
                <a asp-controller="SdsWizard" asp-action="Step" asp-route-step="1">
                    <span class="nav-icon-wrap" aria-hidden="true"><i class="fas fa-plus-circle"></i></span>
                    <span class="nav-label">Add New SDS</span>
                </a>
            </li>
            <li class="@ItemClass("Home", "Reports")">
                <a asp-controller="Home" asp-action="Reports">
                    <span class="nav-icon-wrap" aria-hidden="true"><i class="fas fa-flask"></i></span>
                    <span class="nav-label">All Chemicals</span>
                </a>
            </li>
            <li class="@ItemClass("Home", "Deleted")">
                <a asp-controller="Home" asp-action="Deleted">
                    <span class="nav-icon-wrap" aria-hidden="true"><i class="fas fa-trash-restore"></i></span>
                    <span class="nav-label">Deleted</span>
                </a>
            </li>
            @if (isAdmin)
            {
                <li class="@ControllerItemClass("Users")">
                    <a asp-controller="Users" asp-action="Index">
                        <span class="nav-icon-wrap" aria-hidden="true"><i class="fas fa-users"></i></span>
                        <span class="nav-label">Users</span>
                    </a>
                </li>
            }
        </ul>

        <p class="nav-section-title nav-section-title--account">Account</p>
        <ul class="sidebar-nav-list sidebar-nav-list--account">
            <li class="nav-item logout-item">
                <a asp-controller="Account" asp-action="Logout">
                    <span class="nav-icon-wrap nav-icon-wrap--logout" aria-hidden="true"><i class="fas fa-sign-out-alt"></i></span>
                    <span class="nav-label">Logout</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="sidebar-footer">
        Chemical SDS System v1.0
    </div>
</aside>
