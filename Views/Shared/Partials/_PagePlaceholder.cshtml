@{
    var icon = ViewBag.PageIcon as string ?? "fa-file";
    var title = ViewBag.PageTitle as string ?? "Page";
    var message = ViewBag.PlaceholderMessage as string ?? "This section is under development.";
}

<div class="content-card page-placeholder">
    <i class="fas @icon"></i>
    <h3>@title</h3>
    <p class="text-muted">@message</p>
</div>
