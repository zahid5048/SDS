@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec16Json = Sec16SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-info-circle"></i> Section 16: Other information</h3>

<div class="sec16-subsections-editor" data-initial="@sec16Json">
    <input type="hidden" asp-for="Sec16Subsections" id="Sec16Subsections" />
    <div id="sec16Blocks"></div>
</div>

<div class="row sds-field-grid g-3 mt-2">
    <div class="col-12"><hr /><h5 class="sds-subheading">Lab inventory (optional — internal use)</h5></div>
    <div class="col-md-4"><label asp-for="Quantity" class="form-label">Quantity</label><input asp-for="Quantity" class="form-control" type="number" step="0.01" /></div>
    <div class="col-md-4"><label asp-for="Unit" class="form-label">Unit</label><input asp-for="Unit" class="form-control" placeholder="Liters" /></div>
    <div class="col-md-4"><label asp-for="StorageLocation" class="form-label">Storage location</label><input asp-for="StorageLocation" class="form-control" /></div>
</div>
