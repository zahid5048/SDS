@model ChemicalSDS.Models.Chemical
<h3 class="sds-section-title"><i class="fas fa-info-circle"></i> Section 16. Other information</h3>
<div class="row sds-field-grid g-3">
    <div class="col-md-6"><label asp-for="HMISRatings" class="form-label">HMIS ratings</label><input asp-for="HMISRatings" class="form-control" placeholder="Health: 1, Flammability: 4, Physical: 0" /></div>
    <div class="col-md-6"><label asp-for="NFPARatings" class="form-label">NFPA ratings</label><input asp-for="NFPARatings" class="form-control" placeholder="Health: 1, Flammability: 4, Instability: 0" /></div>
    <div class="col-md-4"><label asp-for="Version" class="form-label">Version</label><input asp-for="Version" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="DateOfPrinting" class="form-label">Date of printing</label><input asp-for="DateOfPrinting" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="DateOfRevision" class="form-label">Date of issue/revision</label><input asp-for="DateOfRevision" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="DateOfPreviousIssue" class="form-label">Date of previous issue</label><input asp-for="DateOfPreviousIssue" class="form-control" /></div>
    <div class="col-12"><label asp-for="Abbreviations" class="form-label">Key to abbreviations</label><textarea asp-for="Abbreviations" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><label asp-for="NoticeToReader" class="form-label">Notice to reader</label><textarea asp-for="NoticeToReader" class="form-control" rows="4"></textarea></div>
    <div class="col-12"><hr /><h5 class="text-muted">Inventory (optional)</h5></div>
    <div class="col-md-4"><label asp-for="Quantity" class="form-label">Quantity</label><input asp-for="Quantity" class="form-control" type="number" step="0.01" /></div>
    <div class="col-md-4"><label asp-for="Unit" class="form-label">Unit</label><input asp-for="Unit" class="form-control" placeholder="Liters" /></div>
    <div class="col-md-4"><label asp-for="StorageLocation" class="form-label">Storage location</label><input asp-for="StorageLocation" class="form-control" /></div>
</div>
