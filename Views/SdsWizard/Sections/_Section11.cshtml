@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec11Json = Sec11SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-skull-crossbones"></i> Section 11: Toxicological information</h3>

<div class="sec11-subsections-editor" data-initial="@sec11Json">
    <input type="hidden" asp-for="Sec11Subsections" id="Sec11Subsections" />
    <div id="sec11SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec11-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
