@model ChemicalSDS.Models.Chemical
<h3 class="sds-section-title"><i class="fas fa-kit-medical"></i> Section 4. First aid measures</h3>
<div class="row sds-field-grid g-3">
    <div class="col-md-6"><label asp-for="EyeContactFirstAid" class="form-label">Eye contact</label><textarea asp-for="EyeContactFirstAid" class="form-control" rows="4"></textarea></div>
    <div class="col-md-6"><label asp-for="InhalationFirstAid" class="form-label">Inhalation</label><textarea asp-for="InhalationFirstAid" class="form-control" rows="4"></textarea></div>
    <div class="col-md-6"><label asp-for="SkinContactFirstAid" class="form-label">Skin contact</label><textarea asp-for="SkinContactFirstAid" class="form-control" rows="4"></textarea></div>
    <div class="col-md-6"><label asp-for="IngestionFirstAid" class="form-label">Ingestion</label><textarea asp-for="IngestionFirstAid" class="form-control" rows="4"></textarea></div>
    <div class="col-12"><label asp-for="RoutesOfExposure" class="form-label">Routes of exposure / symptoms</label><textarea asp-for="RoutesOfExposure" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><label asp-for="ChronicHealthEffects" class="form-label">Chronic / delayed effects</label><textarea asp-for="ChronicHealthEffects" class="form-control" rows="2"></textarea></div>
</div>
