@model ChemicalSDS.Models.Chemical
<h3 class="sds-section-title"><i class="fas fa-leaf"></i> Section 12. Ecological information</h3>
<div class="row sds-field-grid g-3">
    <div class="col-12"><label asp-for="Ecotoxicity" class="form-label">Toxicity</label><textarea asp-for="Ecotoxicity" class="form-control" rows="4"></textarea></div>
    <div class="col-md-6"><label asp-for="PersistenceDegradability" class="form-label">Persistence and degradability</label><textarea asp-for="PersistenceDegradability" class="form-control" rows="2"></textarea></div>
    <div class="col-md-6"><label asp-for="BioaccumulativePotential" class="form-label">Bioaccumulative potential</label><textarea asp-for="BioaccumulativePotential" class="form-control" rows="2"></textarea></div>
    <div class="col-md-6"><label asp-for="MobilityInSoil" class="form-label">Mobility in soil</label><textarea asp-for="MobilityInSoil" class="form-control" rows="2"></textarea></div>
    <div class="col-md-6"><label asp-for="OtherEcologicalEffects" class="form-label">Other adverse effects</label><textarea asp-for="OtherEcologicalEffects" class="form-control" rows="2"></textarea></div>
</div>
