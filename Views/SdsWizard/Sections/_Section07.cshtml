@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec07Json = Sec07SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-warehouse"></i> Section 7: Handling and storage</h3>

<div class="sec07-subsections-editor" data-initial="@sec07Json">
    <input type="hidden" asp-for="Sec07Subsections" id="Sec07Subsections" />
    <div id="sec07SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec07-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
