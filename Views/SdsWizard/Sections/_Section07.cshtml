@model ChemicalSDS.Models.Chemical
<h3 class="sds-section-title"><i class="fas fa-warehouse"></i> Section 7. Handling and storage</h3>
<div class="row sds-field-grid g-3">
    <div class="col-12"><label asp-for="OccupationalHygiene" class="form-label">Occupational hygiene</label><textarea asp-for="OccupationalHygiene" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><label asp-for="HandlingPrecautions" class="form-label">Precautions for safe handling</label><textarea asp-for="HandlingPrecautions" class="form-control" rows="4"></textarea></div>
    <div class="col-12"><label asp-for="SafeStorageConditions" class="form-label">Conditions for safe storage</label><textarea asp-for="SafeStorageConditions" class="form-control" rows="4"></textarea></div>
    <div class="col-12"><label asp-for="IncompatibleMaterials" class="form-label">Incompatible materials</label><textarea asp-for="IncompatibleMaterials" class="form-control" rows="2"></textarea></div>
</div>
