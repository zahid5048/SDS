@model ChemicalSDS.Models.Chemical
<h3 class="sds-section-title"><i class="fas fa-truck"></i> Section 14. Transport information</h3>
<div class="row sds-field-grid g-3">
    <div class="col-md-3"><label asp-for="UNNumber" class="form-label">UN number</label><input asp-for="UNNumber" class="form-control" placeholder="UN1170" /></div>
    <div class="col-md-9"><label asp-for="UNProperShippingName" class="form-label">UN proper shipping name</label><input asp-for="UNProperShippingName" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="TransportHazardClass" class="form-label">Transport hazard class</label><input asp-for="TransportHazardClass" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="PackingGroup" class="form-label">Packing group</label><input asp-for="PackingGroup" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="EnvironmentalHazardsTransport" class="form-label">Environmental hazards</label><input asp-for="EnvironmentalHazardsTransport" class="form-control" /></div>
    <div class="col-12"><label asp-for="TransportSpecialPrecautions" class="form-label">Special precautions for user</label><textarea asp-for="TransportSpecialPrecautions" class="form-control" rows="3"></textarea></div>
</div>
