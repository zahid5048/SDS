@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec14Json = Sec14SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-truck"></i> Section 14: Transport information</h3>

<div class="sec14-subsections-editor" data-initial="@sec14Json">
    <input type="hidden" asp-for="Sec14Subsections" id="Sec14Subsections" />
    <div id="sec14SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec14-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
