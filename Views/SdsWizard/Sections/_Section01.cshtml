@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec01Json = Sec01SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-id-card"></i> Section 1: Identification</h3>

<input type="hidden" asp-for="ProductIdentifier" id="Sec01ProductIdentifierSync" />

<div class="sec01-subsections-editor" data-initial="@sec01Json">
    <input type="hidden" asp-for="Sec01Subsections" id="Sec01Subsections" />
    <div id="sec01SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec01-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
