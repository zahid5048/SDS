@model ChemicalSDS.Models.Chemical
@using System.Text.Json
@using ChemicalSDS.Models
@{
    var sec02Json = Sec02BlockCodec.ResolveStoredJson(Model);
    var ghsJson = JsonSerializer.Serialize(GhsPictogramCatalog.All.Select(g => new { code = g.Code, label = g.Label, imagePath = g.ImagePath }));
}
<h3 class="sds-section-title"><i class="fas fa-exclamation-triangle"></i> Section 2: Hazard(s) identification</h3>
<p class="text-muted small mb-3">Add <strong>text subsections</strong> (heading + description), <strong>GHS pictogram</strong> blocks (select icons), or <strong>CAS tables</strong> (title + rows). Reorder by removing and re-adding if needed.</p>

<script type="application/json" id="Sec02BlocksInitial">@Html.Raw(sec02Json)</script>
<script>window.__sec02GhsCatalog = @Html.Raw(ghsJson);</script>

<input type="hidden" asp-for="GhsPictogramCodes" id="GhsPictogramCodes" />

<div class="sec02-blocks-editor">
    <input type="hidden" asp-for="Sec02Blocks" id="Sec02Blocks" />
    <div id="sec02BlocksContainer"></div>
    <div class="d-flex flex-wrap gap-2 mt-2">
        <button type="button" class="btn btn-outline-primary btn-sm sec02-add-text"><i class="fas fa-plus"></i> Add text subsection</button>
        <button type="button" class="btn btn-outline-warning btn-sm sec02-add-pictograms"><i class="fas fa-image"></i> Add hazard pictograms</button>
        <button type="button" class="btn btn-outline-info btn-sm sec02-add-table"><i class="fas fa-table"></i> Add CAS table</button>
    </div>
</div>
