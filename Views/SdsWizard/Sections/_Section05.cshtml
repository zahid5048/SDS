@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec05Json = Sec05SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-fire"></i> Section 5: Firefighting measures</h3>

<div class="sec05-subsections-editor" data-initial="@sec05Json">
    <input type="hidden" asp-for="Sec05Subsections" id="Sec05Subsections" />
    <div id="sec05SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec05-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
