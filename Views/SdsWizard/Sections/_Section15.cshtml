@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec15Json = Sec15SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-gavel"></i> Section 15: Regulatory information</h3>

<div class="sec15-subsections-editor" data-initial="@sec15Json">
    <input type="hidden" asp-for="Sec15Subsections" id="Sec15Subsections" />
    <div id="sec15SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec15-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
