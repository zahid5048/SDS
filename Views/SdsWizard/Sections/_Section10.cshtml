@model ChemicalSDS.Models.Chemical
@using ChemicalSDS.Models
@{
    var sec10Json = Sec10SubsectionCodec.ResolveStoredJson(Model);
}
<h3 class="sds-section-title"><i class="fas fa-shield-alt"></i> Section 10: Stability and reactivity</h3>

<div class="sec10-subsections-editor" data-initial="@sec10Json">
    <input type="hidden" asp-for="Sec10Subsections" id="Sec10Subsections" />
    <div id="sec10SubsectionRows" class="d-flex flex-column gap-3"></div>
    <button type="button" class="btn btn-outline-primary btn-sm mt-3 sec10-add-subsection">
        <i class="fas fa-plus"></i> Add subsection
    </button>
</div>
