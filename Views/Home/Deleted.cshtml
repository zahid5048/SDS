@model ChemicalSDS.Models.DashboardViewModel
@{
    ViewData["Title"] = "Deleted Chemicals";
}

@section Scripts {
    <script src="~/js/chemical-search.js" asp-append-version="true"></script>
}

<div class="dash-page-intro mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="dash-intro-title"><i class="fas fa-trash-restore me-2"></i> Deleted Chemicals</h2>
            <p class="dash-intro-sub mb-0">Restore accidentally removed records or permanently delete them</p>
        </div>
        <a asp-action="Reports" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to All Chemicals
        </a>
    </div>
</div>

<partial name="Partials/_ChemicalsTable" model="Model" />
