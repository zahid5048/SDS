@model List<ChemicalSDS.Models.Chemical>
@{
    ViewData["Title"] = "Hazard Categories";
    ViewBag.PageTitle = "Hazard Categories";
    ViewBag.PageIcon = "fa-exclamation-triangle";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="fas fa-tags me-2"></i> Hazard Categories</h4>
        <span class="badge bg-primary">@Model.Count chemicals</span>
    </div>
    <div class="table-responsive">
        <table class="table chemicals-table">
            <thead>
                <tr>
                    <th>Chemical</th>
                    <th>Classification</th>
                    <th>Signal Word</th>
                    <th>Hazard Statements</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chemical in Model)
                {
                    <tr>
                        <td><strong>@chemical.ProductIdentifier</strong></td>
                        <td>@chemical.Classification</td>
                        <td>
                            @if (chemical.SignalWord == "Danger")
                            {
                                <span class="badge-danger">Danger</span>
                            }
                            else
                            {
                                <span class="badge-warning">@chemical.SignalWord</span>
                            }
                        </td>
                        <td><small>@chemical.HazardStatements</small></td>
                        <td>
                            <a asp-action="SDSDetails" asp-route-id="@chemical.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-file-alt"></i> SDS
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

