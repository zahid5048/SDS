@model List<ChemicalSDS.Models.Chemical>
@{
    ViewData["Title"] = "Hazard Categories";
    ViewBag.PageTitle = "Hazard Categories";
    ViewBag.PageIcon = "fa-exclamation-triangle";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="fas fa-tags me-2"></i> Hazard Categories</h4>
        <span class="badge bg-primary">@Model.Count chemicals</span>
    </div>
    <div class="table-responsive">
        <table class="table chemicals-table">
            <thead>
                <tr>
                    <th>Chemical</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var chemical in Model)
                {
                    <tr>
                        <td><strong>@(string.IsNullOrWhiteSpace(Sec01SubsectionCodec.ShortProductLabel(chemical.ProductIdentifier)) ? "Untitled" : Sec01SubsectionCodec.ShortProductLabel(chemical.ProductIdentifier))</strong></td>
                        <td>
                            <a asp-action="SDSDetails" asp-route-id="@chemical.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-file-alt"></i> SDS
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

