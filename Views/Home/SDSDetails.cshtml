        <div class="section-header"><h4><i class="fas fa-id-card"></i> Section 1: Identification</h4></div>
        <div class="section-body">
            <table class="table table-bordered mb-0">
                <tr><th>GHS Product Identifier</th><td>@Model.ProductIdentifier</td></tr>
                <tr><th>Chemical Name</th><td>@Model.ChemicalName</td></tr>
                <tr><th>Other Means of Identification</th><td>@Model.OtherMeansOfId</td></tr>
                <tr><th>Product Type</th><td>@Model.ProductType</td></tr>
                <tr><th>Product Use</th><td>@Model.ProductUse</td></tr>
                <tr><th>Synonym</th><td>@Model.Synonym</td></tr>
                <tr><th>SDS #</th><td>@Model.SDSNumber</td></tr>
                <tr><th>Supplier Details</th><td>@Html.Raw(Model.SupplierDetails?.Replace("\n", "<br/>"))</td></tr>
                <tr><th>24-Hour Telephone</th><td>@Model.EmergencyPhone</td></tr>
            </table>
        </div>
    </div>

