            {
                <div class="sds-detail-row">
                    <span class="sds-detail-label">Signal word</span>
                    <span class="sds-detail-value"><span class="badge @(Model.SignalWord == "Danger" ? "bg-danger" : "bg-warning text-dark")">@Model.SignalWord</span></span>
                </div>
            }
            <partial name="Partials/Sds/_GhsDisplay" model="Model" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Hazard statements", Value = Model.HazardStatements })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Precautionary – General", Value = Model.PrecautionaryGeneral })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Precautionary – Prevention", Value = Model.PrecautionaryPrevention })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Precautionary – Response", Value = Model.PrecautionaryResponse })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Precautionary – Storage", Value = Model.PrecautionaryStorage })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Precautionary – Disposal", Value = Model.PrecautionaryDisposal })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Hazards not otherwise classified", Value = Model.HazardsNotOtherwiseClassified })" />
        </div>
    </div>

    <div id="sec3" class="sds-section">
