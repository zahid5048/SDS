        <div class="section-body sds-detail-layout">
            @if (!string.IsNullOrEmpty(Model.OccupationalExposureLimits))
            {
                <div class="sds-detail-row sds-detail-row-block">
                    <span class="sds-detail-label">Occupational exposure limits</span>
                    <div class="sds-detail-value">
                        <table class="table table-sm table-bordered sds-oel-table mb-0">
                            <thead><tr><th>Ingredient name</th><th>Exposure limits</th></tr></thead>
                            <tbody>
                                @foreach (var line in Model.OccupationalExposureLimits.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    var parts = line.Split('|', 2);
                                    <tr>
                                        <td>@(parts.Length > 0 ? parts[0].Trim() : line.Trim())</td>
