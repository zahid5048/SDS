            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Chronic — Carcinogenicity", Value = Model.ChronicCarcinogenicity })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Chronic — Mutagenicity", Value = Model.ChronicMutagenicity })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Chronic — Teratogenicity", Value = Model.ChronicTeratogenicity })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Developmental effects", Value = Model.DevelopmentalEffects })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Fertility effects", Value = Model.FertilityEffects })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Acute toxicity estimates", Value = Model.AcuteToxicityEstimates })" />
        </div>
    </div>

    <div id="sec12" class="sds-section">
        <div class="section-header"><h4><i class="fas fa-leaf"></i> Section 12: Ecological Information</h4></div>
        <div class="section-body sds-detail-layout">
            <partial name="Partials/Sds/_SdsPipeTable" model="@(new ChemicalSDS.Models.SdsPipeTableModel { Title = "Toxicity", Headers = new[] { "Product/ingredient name", "Result", "Species", "Exposure" }, Data = Model.Ecotoxicity })" />
            @if (!string.IsNullOrWhiteSpace(Model.Ecotoxicity) && !Model.Ecotoxicity.Contains('|'))
            {
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Toxicity", Value = Model.Ecotoxicity })" />
            }
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Persistence and degradability", Value = Model.PersistenceDegradability })" />
            <partial name="Partials/Sds/_SdsPipeTable" model="@(new ChemicalSDS.Models.SdsPipeTableModel { Title = "Bioaccumulative potential", Headers = new[] { "Product/ingredient name", "LogP\u2080w", "BCF", "Potential" }, Data = Model.BioaccumulativePotential })" />
            @if (!string.IsNullOrWhiteSpace(Model.BioaccumulativePotential) && !Model.BioaccumulativePotential.Contains('|'))
            {
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Bioaccumulative potential", Value = Model.BioaccumulativePotential })" />
            }
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Soil/water partition coefficient (Koc)", Value = Model.MobilityInSoil })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Other adverse effects", Value = Model.OtherEcologicalEffects })" />
        </div>
    </div>

    <div id="sec13" class="sds-section">
        <div class="section-header"><h4><i class="fas fa-trash"></i> Section 13: Disposal Considerations</h4></div>
        <div class="section-body"><p>@Model.DisposalMethods</p></div>
    </div>

    <div id="sec14" class="sds-section">
        <div class="section-header"><h4><i class="fas fa-truck"></i> Section 14: Transport Information</h4></div>
        <div class="section-body sds-detail-layout">
            <partial name="Partials/Sds/_SdsTransportMatrixDisplay" model="Model" />
            @if (string.IsNullOrWhiteSpace(Model.TransportRegulations) || !Model.TransportRegulations.Contains('|'))
            {
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "UN number", Value = Model.UNNumber })" />
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "UN proper shipping name", Value = Model.UNProperShippingName })" />
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Transport hazard class(es)", Value = Model.TransportHazardClass })" />
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Packing group", Value = Model.PackingGroup })" />
                <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Environmental hazards", Value = Model.EnvironmentalHazardsTransport })" />
            }
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "DOT classification", Value = Model.TransportDotClassification })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "TDG classification", Value = Model.TransportTdgClassification })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "IATA", Value = Model.TransportIataClassification })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Special precautions for user", Value = Model.TransportSpecialPrecautions })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Transport in bulk (MARPOL / IBC Code)", Value = Model.TransportBulkMarpol })" />
        </div>
    </div>

    <div id="sec15" class="sds-section">
        <div class="section-header"><h4><i class="fas fa-gavel"></i> Section 15: Regulatory Information</h4></div>
        <div class="section-body sds-detail-layout sds-regulatory-detail">
            <div class="sds-regulatory-group"><strong class="sds-regulatory-group-title">U.S. Federal regulations</strong></div>
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "TSCA 8(a) CDR Exempt/Partial exemption", Value = Model.RegTscaCdrExempt })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Clean Air Act Section 112 (b) HAPs", Value = Model.RegCleanAirActHaps })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Clean Air Act Section 602 Class I", Value = Model.RegCleanAirActClassI })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Clean Air Act Section 602 Class II", Value = Model.RegCleanAirActClassII })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "DEA List I", Value = Model.RegDeaListI })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "DEA List II", Value = Model.RegDeaListII })" />
            <div class="sds-regulatory-group"><strong class="sds-regulatory-group-title">SARA</strong></div>
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "SARA 302/304 — Composition", Value = Model.RegSara302Composition ?? Model.SARA302304 })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "SARA 304 RQ", Value = Model.RegSara304RQ })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "SARA 311/312 — Classification", Value = Model.RegSara311312Classification })" />
            <div class="sds-regulatory-group"><strong class="sds-regulatory-group-title">State regulations</strong></div>
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Massachusetts", Value = Model.RegStateMassachusetts })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "New York", Value = Model.RegStateNewYork })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "New Jersey", Value = Model.RegStateNewJersey })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Pennsylvania", Value = Model.RegStatePennsylvania })" />
            <div class="sds-regulatory-group"><strong class="sds-regulatory-group-title">International regulations</strong></div>
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Chemical Weapon Convention", Value = Model.RegChemWeaponConvention })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Montreal Protocol", Value = Model.RegMontrealProtocol })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Stockholm Convention", Value = Model.RegStockholmConvention })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Rotterdam Convention (PIC)", Value = Model.RegRotterdamConvention })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "UNECE Aarhus Protocol", Value = Model.RegUneceAarhus })" />
            <div class="sds-regulatory-group"><strong class="sds-regulatory-group-title">Inventory list</strong></div>
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Australia", Value = Model.RegInventoryAustralia })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Canada", Value = Model.RegInventoryCanada })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "China", Value = Model.RegInventoryChina })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Europe", Value = Model.RegInventoryEurope })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Japan (ENCS)", Value = Model.RegInventoryJapanEncs })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Japan (ISHL)", Value = Model.RegInventoryJapanIshl })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Malaysia", Value = Model.RegInventoryMalaysia })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "New Zealand", Value = Model.RegInventoryNewZealand })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Philippines", Value = Model.RegInventoryPhilippines })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Republic of Korea", Value = Model.RegInventoryKorea })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Taiwan", Value = Model.RegInventoryTaiwan })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Thailand", Value = Model.RegInventoryThailand })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Turkey", Value = Model.RegInventoryTurkey })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "United States", Value = Model.RegInventoryUnitedStates })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Viet Nam", Value = Model.RegInventoryVietnam })" />
        </div>
    </div>

    <div id="sec16" class="sds-section mb-4">
        <div class="section-header"><h4><i class="fas fa-info-circle"></i> Section 16: Other Information</h4></div>
        <div class="section-body sds-detail-layout sds-section16-detail">
            <partial name="Partials/Sds/_HmisDisplay" model="Model" />
            <partial name="Partials/Sds/_NfpaDiamondDisplay" model="Model" />
            <partial name="Partials/Sds/_SdsPipeTable" model="@(new ChemicalSDS.Models.SdsPipeTableModel { Title = "Procedure used to derive the classification", Headers = new[] { "Classification", "Justification" }, Data = !string.IsNullOrWhiteSpace(Model.ClassificationProcedure) ? $"{Model.ClassificationProcedure}|{Model.ClassificationJustification}" : null })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Date of printing", Value = Model.DateOfPrinting })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Date of issue / revision", Value = Model.DateOfRevision })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Date of previous issue", Value = Model.DateOfPreviousIssue })" />
            <partial name="Partials/Sds/_SdsDetailBlock" model="@(new ChemicalSDS.Models.SdsDetailRow { Label = "Version", Value = Model.Version })" />
            @if (!string.IsNullOrWhiteSpace(Model.Abbreviations))
            {
                <div class="sds-detail-row sds-detail-row-block">
                    <span class="sds-detail-label sds-sec16-blue-label">Key to abbreviations</span>
                    <div class="sds-detail-value"><pre class="sds-abbrev-pre mb-0">@Model.Abbreviations</pre></div>
                </div>
            }
            <partial name="Partials/Sds/_SdsSection16Footer" model="Model" />
        </div>
    </div>
</div>

