@model List<ChemicalSDS.Models.Chemical>
@{
    ViewData["Title"] = "Chemical Safety Dashboard";
    var searchString = ViewData["CurrentFilter"] as string;
}

<div class="container mt-4">
    <div class="text-center">
        <h1 class="display-4">🧪 Chemical Safety Data Sheet System</h1>
        <p class="lead">Manage and view Safety Data Sheets (SDS) for all chemicals</p>
    </div>

    <!-- Stats Cards -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Chemicals</h5>
                    <h2 class="display-4">@ViewBag.TotalChemicals</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h5 class="card-title">Danger Level Chemicals</h5>
                    <h2 class="display-4">@ViewBag.DangerChemicals</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Search -->
    <div class="card mt-4">
        <div class="card-body">
            <form method="get">
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Search by chemical name or CAS number..." value="@searchString">
                    <button type="submit" class="btn btn-primary">🔍 Search</button>
                    @if (!string.IsNullOrEmpty(searchString))
                    {
                        <a href="/Home" class="btn btn-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Chemicals Table -->
    <div class="card mt-4">
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">📋 Chemical Inventory</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Chemical Name</th>
                            <th>CAS Number</th>
                            <th>Signal Word</th>
                            <th>Flash Point</th>
                            <th>Storage Location</th>
                            <th>Quantity</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var chemical in Model)
                        {
                            <tr>
                                <td><strong>@chemical.ChemicalName</strong></td>
                                <td>@chemical.CASNumber</td>
                                <td>
                                    @if (chemical.SignalWord == "Danger")
                                    {
                                        <span class="badge bg-danger">⚠️ Danger</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">⚠️ Warning</span>
                                    }
                                </td>
                                <td>@chemical.FlashPoint</td>
                                <td>@chemical.StorageLocation</td>
                                <td>@chemical.Quantity @chemical.Unit</td>
                                <td>
                                    <a href="/Home/Details/@chemical.Id" class="btn btn-sm btn-info">📄 View SDS</a>
                                    <a href="/Home/Emergency/@chemical.Id" class="btn btn-sm btn-danger">🚨 Emergency</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">
            No chemicals found. Add chemicals to the database.
        </div>
    }
</div>